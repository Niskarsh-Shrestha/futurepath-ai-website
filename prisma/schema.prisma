generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PARENT
  ADMIN
}

enum AssessmentStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  SUBMITTED
}

model User {
  id            String    @id @default(cuid())
  firstName     String
  lastName      String
  email         String    @unique
  passwordHash  String?
  emailVerified DateTime?
  image         String?
  phone         String?
  country       String?
  timezone      String?
  bio           String?
  role          Role      @default(PARENT)

  emailNotifications  Boolean @default(true)
  assessmentReminders Boolean @default(true)
  roadmapUpdates      Boolean @default(true)
  marketingEmails     Boolean @default(false)
  subscription Subscription?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts            Account[]
  passwordResetTokens PasswordResetToken[]
  emailVerifyTokens   EmailVerificationToken[]
  children            Child[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

model Child {
  id            String   @id @default(cuid())
  userId        String
  firstName     String
  lastName      String
  dateOfBirth   DateTime
  gender        String?
  school        String?
  grade         String?
  country       String?
  interests     String[] @default([])
  strengths     String[] @default([])
  learningStyle String?
  profileImage  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  assessments Assessment[]

  @@index([userId])
  @@map("children")
}

model Assessment {
  id          String           @id @default(cuid())
  childId     String
  status      AssessmentStatus @default(DRAFT)
  progress    Int              @default(0)
  completedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  child      Child               @relation(fields: [childId], references: [id], onDelete: Cascade)
  answers    AssessmentAnswer[]
  aiAnalysis AIAnalysis?

  @@index([childId])
  @@map("assessments")
}

model AssessmentAnswer {
  id           String   @id @default(cuid())
  assessmentId String
  questionId   String
  answer       Json
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, questionId])
  @@index([assessmentId])
  @@map("assessment_answers")
}

model AIAnalysis {
  id                     String   @id @default(cuid())
  assessmentId           String   @unique
  summary                String   @db.Text
  strengths              String[]
  weaknesses             String[]
  learningStyleAnalysis  String   @db.Text
  personalityAnalysis    String   @db.Text
  careerInterestAnalysis String   @db.Text
  confidenceScore        Int
  model                  String
  promptVersion          String
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  assessment    Assessment   @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  careerMatches CareerMatch[]
  recommendations CareerRecommendation[]

  @@map("ai_analyses")
}

model CareerMatch {
  id         String   @id @default(cuid())
  analysisId String
  career     String
  score      Int
  reason     String   @db.Text
  createdAt  DateTime @default(now())

  analysis AIAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@index([analysisId])
  @@map("career_matches")
}

model CareerRecommendation {
  id             String   @id @default(cuid())
  analysisId     String
  careerTitle    String
  careerCategory String
  matchScore     Int
  salaryRange    String
  educationLevel String
  description    String   @db.Text
  futureDemand   String
  difficulty     String
  reasoning      String   @db.Text
  createdAt      DateTime @default(now())

  analysis   AIAnalysis  @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  careerPath CareerPath[]
  skillGaps  SkillGap[]
  roadmap LearningRoadmap?
  report CareerReport?

  @@index([analysisId])
  @@map("career_recommendations")
}

model CareerPath {
  id               String @id @default(cuid())
  recommendationId String
  step             Int
  title            String
  description      String @db.Text
  order            Int

  recommendation CareerRecommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)

  @@index([recommendationId])
  @@map("career_paths")
}

model SkillGap {
  id               String @id @default(cuid())
  recommendationId String
  skill            String
  currentLevel     Int
  requiredLevel    Int
  priority         String

  recommendation CareerRecommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)

  @@index([recommendationId])
  @@map("skill_gaps")
}


model LearningRoadmap {
  id                 String   @id @default(cuid())
  recommendationId   String   @unique
  title              String
  description        String   @db.Text
  estimatedDuration   String
  difficulty         String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  recommendation CareerRecommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  phases         RoadmapPhase[]

  @@map("learning_roadmaps")
}

model RoadmapPhase {
  id             String @id @default(cuid())
  roadmapId      String
  title          String
  description    String @db.Text
  order          Int
  estimatedWeeks Int

  roadmap    LearningRoadmap    @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  resources  LearningResource[]
  milestones Milestone[]

  @@index([roadmapId])
  @@map("roadmap_phases")
}

model LearningResource {
  id             String  @id @default(cuid())
  phaseId        String
  title          String
  type           String
  provider       String
  url            String
  estimatedHours Int
  isOptional     Boolean @default(false)
  isFree         Boolean @default(true)
  isCompleted    Boolean @default(false)
  completedAt    DateTime?

  phase RoadmapPhase @relation(fields: [phaseId], references: [id], onDelete: Cascade)

  @@index([phaseId])
  @@map("learning_resources")
}

model Milestone {
  id          String  @id @default(cuid())
  phaseId     String
  title       String
  description String  @db.Text
  order       Int
  isCompleted Boolean @default(false)
  completedAt DateTime?

  phase RoadmapPhase @relation(fields: [phaseId], references: [id], onDelete: Cascade)

  @@index([phaseId])
  @@map("milestones")
}

model CareerReport {
  id              String   @id @default(cuid())
  recommendationId String  @unique
  title           String
  summary         String   @db.Text
  pdfPath         String?
  generatedAt     DateTime @default(now())
  updatedAt       DateTime @updatedAt

  recommendation CareerRecommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)

  @@map("career_reports")
}

enum Plan {
  FREE
  PREMIUM_MONTHLY
  PREMIUM_ANNUAL
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
}

model Subscription {
  id        String             @id @default(cuid())
  userId    String             @unique
  plan      Plan
  status    SubscriptionStatus @default(ACTIVE)
  startedAt DateTime           @default(now())
  expiresAt DateTime?
  updatedAt DateTime           @updatedAt

  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  history BillingHistory[]

  @@map("subscriptions")
}

model BillingHistory {
  id             String   @id @default(cuid())
  subscriptionId String
  plan           Plan
  amount         Float
  status         String
  createdAt      DateTime @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@map("billing_history")
}